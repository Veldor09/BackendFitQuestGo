# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR
# ==============================================================================
PORT=3000
FRONT_URL=http://localhost:5173,http://localhost:3000,http://localhost:8081

# ==============================================================================
# BASE DE DATOS (POSTGRESQL / TYPEORM)
# ==============================================================================
# Usa 'localhost' si ejecutas NestJS localmente (pnpm start:dev)
# Usa 'db' si ejecutas todo el stack mediante docker-compose
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fitquestgo
DB_PASSWORD=fitquestgo
DB_DATABASE=fitquestgo

# ==============================================================================
# AUTENTICACIÓN Y SEGURIDAD (JWT & COOKIES)
# ==============================================================================
JWT_ACCESS_SECRET=your_jwt_secret_key_here
JWT_ACCESS_TTL=900
REFRESH_TTL_DIAS=7
COOKIE_SECURE=false

# ==============================================================================
# SERVICIO DE CORREO (GMAIL / NODEMAILER)
# ==============================================================================
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=tu_contraseña_de_aplicacion
