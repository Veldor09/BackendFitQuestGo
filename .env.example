# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR
# ==============================================================================
PORT=3000
FRONT_URL=http://localhost:5173,http://localhost:3000,http://localhost:8081

# ==============================================================================
# BASE DE DATOS (POSTGRESQL / TYPEORM)
# ==============================================================================
# Usa 'localhost' si ejecutas NestJS localmente (pnpm start:dev)
# Usa 'db' si ejecutas todo el stack mediante docker-compose
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fitquestgo
DB_PASSWORD=fitquestgo
DB_DATABASE=fitquestgo

# ==============================================================================
# AUTENTICACIÓN Y SEGURIDAD (JWT & COOKIES)
# ==============================================================================
JWT_ACCESS_SECRET=your_jwt_secret_key_here
JWT_ACCESS_TTL=900
REFRESH_TTL_DIAS=7
COOKIE_SECURE=false

# ==============================================================================
# SERVICIO DE CORREO (GMAIL / NODEMAILER)
# ==============================================================================
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=tu_contraseña_de_aplicacion

# ==============================================================================
# AVISOS FUERA DE LA APP (FIREBASE CLOUD MESSAGING) - OPCIONAL
# Sin esto el sistema funciona igual; solo no sale nada del celular.
# La cuenta de servicio es SECRETA: nunca va a git. Ver docs/push-notificaciones.md
# (repo de la app). Una de las dos:
#   FIREBASE_SERVICE_ACCOUNT_BASE64 = el .json de la clave, en base64 (lo comodo en Render)
#   FIREBASE_SERVICE_ACCOUNT_JSON   = el .json tal cual
# ==============================================================================
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# FIREBASE_SERVICE_ACCOUNT_JSON=
